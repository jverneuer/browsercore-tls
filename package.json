{
  "name": "@network/tls",
  "version": "0.1.0",
  "description": "TLS 1.3 (and 1.2 fallback) client implemented entirely in TypeScript. Depends on @network/transport and @network/crypto — never node:crypto directly.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@network/crypto": "workspace:*",
    "@network/transport": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
