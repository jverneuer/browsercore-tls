{
    // Dual typecheck gate (run by `npm run typecheck`): compiles src/ AND the
    // tests so type-level proofs (the @ts-expect-error conformance check in
    // tests/tls-engine-conformance.test.ts) are enforced by CI, not just by
    // vitest's transpile-only run.
    //
    // `exclude` is OVERRIDDEN here on purpose: it is inherited from
    // ./tsconfig.json, whose exclude list drops "tests" — without this
    // override the `include` below would match nothing and the gate would
    // silently typecheck zero test files (the family-wide tsconfig.test.json
    // bug this file fixes).
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "rootDir": "."
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
